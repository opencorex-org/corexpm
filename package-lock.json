{
  "name": "corexpm-monorepo",
  "version": "0.1.0-dev",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "corexpm-monorepo",
      "version": "0.1.0-dev",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/corexpm": {
      "resolved": "packages/corexpm",
      "link": true
    },
    "packages/corexpm": {
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "corexpm": "bin/corexpm.js"
      },
      "engines": {
        "node": ">=16.0.0"
      }
    }
  }
}
